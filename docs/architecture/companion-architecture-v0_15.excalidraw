    },
    {
      "id": "tex-195",
      "type": "text",
      "x": 0,
      "y": 3476.0,
      "width": 2425.8,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 83678550,
      "version": 12,
      "versionNonce": 1024948059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791900000000,
      "link": null,
      "locked": false,
      "text": "Each card: table name, what it is for (one line), then columns. A line starts (dot) at the child column that holds the reference and ends (arrowhead) on the parent's id row. N or 1 at the start = cardinality. Line colour = the parent's group. Every line is also explained in words at the bottom of this section.\nThere are NO database foreign keys: '→ table' is a reference enforced in the Repo layer. Not drawn: company_id → companies (every table), actor links to admins (created_by / updated_by / published_by),\nand polymorphic references (files.owner_*, activity_log.entity_* and parent/root_log_id). id = internal bigint (joins only, never sent to clients) · public_id = client-facing (admins: clerk_user_id · chatbot_users: host_user_id) · timestamps timestamptz · status/type = smallint enums\nencrypted_* = AES-256-GCM under the company key (iv + encryption_key_version on the row) · money columns = USD numeric(12,6) · company_id + RLS on every table (admins and platform eval_cases have their own policies) · * = new or changed since v0.1",
      "originalText": "Each card: table name, what it is for (one line), then columns. A line starts (dot) at the child column that holds the reference and ends (arrowhead) on the parent's id row. N or 1 at the start = cardinality. Line colour = the parent's group. Every line is also explained in words at the bottom of this section.\nThere are NO database foreign keys: '→ table' is a reference enforced in the Repo layer. Not drawn: company_id → companies (every table), actor links to admins (created_by / updated_by / published_by),\nand polymorphic references (files.owner_*, activity_log.entity_* and parent/root_log_id). id = internal bigint (joins only, never sent to clients) · public_id = client-facing (admins: clerk_user_id · chatbot_users: host_user_id) · timestamps timestamptz · status/type = smallint enums\nencrypted_* = AES-256-GCM under the company key (iv + encryption_key_version on the row) · money columns = USD numeric(12,6) · company_id + RLS on every table (admins and platform eval_cases have their own policies) · * = new or changed since v0.1",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
