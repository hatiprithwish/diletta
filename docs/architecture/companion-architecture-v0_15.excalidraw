    {
      "id": "tex-84",
      "type": "text",
      "x": 1554,
      "y": 934.5,
      "width": 741.6,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
