      "boundElements": [],
      "updated": 1790900000000,
      "link": null,
      "locked": false,
      "text": "Adapter interface: execute · readback · undo · getSchema\n  v1: REST (adapter_type 1)   future: host-exec (2), MCP (3)\nAuthStrategy registry (config-driven, no per-customer code):\n  v1: jwt_forward   future: api_key_header · oauth2_cc · oauth2_authcode · hmac_signed\n  credentialScope: none | company | chatbot_user\nTool manifest (tool_definitions): call_op · readback_op {compare} · inverse_op\n  generated from OpenAPI, curated by operator\nCredentials (future types) decrypted via Crypto module",
      "originalText": "Adapter interface: execute · readback · undo · getSchema\n  v1: REST (adapter_type 1)   future: host-exec (2), MCP (3)\nAuthStrategy registry (config-driven, no per-customer code):\n  v1: jwt_forward   future: api_key_header · oauth2_cc · oauth2_authcode · hmac_signed\n  credentialScope: none | company | chatbot_user\nTool manifest (tool_definitions): call_op · readback_op {compare} · inverse_op\n  generated from OpenAPI, curated by operator\nCredentials (future types) decrypted via Crypto module",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
