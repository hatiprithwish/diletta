    {
      "id": "tex-44",
      "type": "text",
      "x": 1174,
      "y": 24.5,
      "width": 764.4,
      "height": 192.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
