      "boundElements": [],
      "updated": 1791900000000,
      "link": null,
      "locked": false,
      "text": "Read as: child.column → parent.id · N:1 = many child rows point at one parent row (the 'N' is printed where the line leaves the child) · 1:1 = at most one child row per parent row · the arrowhead always lands on the parent's id row",
      "originalText": "Read as: child.column → parent.id · N:1 = many child rows point at one parent row (the 'N' is printed where the line leaves the child) · 1:1 = at most one child row per parent row · the arrowhead always lands on the parent's id row",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
