# The eval harness's settings (docs/runbooks/evals.md). Copy to evals/.env (gitignored) and fill in.
# Comments go on their own line: uv's --env-file can't parse one after a value.
DILETTA_API_URL=
# The private JWK from `python -m diletta_evals keygen` (vault), single-quoted
EVAL_JWT_PRIVATE_KEY=
DILETTA_COMPANY_ID=
# The company's staging connection
DILETTA_CONNECTION_ID=
EVAL_HOST_USER=eval-user
EVAL_HOST_KIND=test_host
TEST_HOST_ISSUER=https://diletta-test-host-staging.hatiprithwish.workers.dev
# Vault
TEST_HOST_ADMIN_SECRET=

# The load test (docs/runbooks/load.md): the load test company, not the eval company above. The key, API and test host
# are the same.
LOAD_COMPANY_ID=
# Its staging connection
LOAD_CONNECTION_ID=
# An origin that connection allows
LOAD_ORIGIN=
# Optional: the chatbot the chats talk to (default: the company's default)
LOAD_CHATBOT_ID=
