{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "rubric": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contains",
              "not_contains"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "kind",
          "text"
        ]
      }
    },
    "toolCalls": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toolName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "#/$defs/EvalCaseJsonValue"
            },
            "maxProperties": 50
          }
        },
        "required": [
          "toolName",
          "args"
        ]
      }
    },
    "forbiddenTools": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "readbacks": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toolName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "expect": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "#/$defs/EvalCaseJsonValue"
            },
            "maxProperties": 50,
            "minProperties": 1
          }
        },
        "required": [
          "toolName",
          "expect"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "rubric",
    "rules",
    "toolCalls",
    "forbiddenTools",
    "readbacks"
  ],
  "$defs": {
    "EvalCaseJsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvalCaseJsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/EvalCaseJsonValue"
          }
        }
      ]
    }
  },
  "title": "EvalCaseExpectations",
  "description": "eval_cases.expectations at schemaVersion 2 (older bodies upgraded by loadEvalCaseExpectations)"
}
