{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "message"
              },
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "kind",
              "role",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "tool_call"
              },
              "toolName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "toolVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "number",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "toolName",
              "toolVersion",
              "status",
              "summary"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "title": "EvalTranscript",
  "description": "An eval attempt's transcript file in R2 (files.owner_type eval_result) at schemaVersion 1"
}
