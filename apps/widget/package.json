{
  "name": "widget",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:setup": "tsx scripts/devSetup.ts",
    "build": "vite build --configLoader runner && vite build --configLoader runner --mode lib && tsx scripts/checkBundleSize.ts",
    "deploy": "wrangler deploy",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.129",
    "@app/schemas": "workspace:*",
    "@app/ui": "workspace:*",
    "@cloudflare/think": "0.19.0",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "0.24.0",
    "ai": "7.0.126",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.18.6",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
