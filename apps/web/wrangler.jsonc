{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diletta-web",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "VITE_API_URL": "http://localhost:8787",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "staging": {
      "name": "diletta-web-staging",
      "vars": {
        "VITE_API_URL": "https://diletta-worker-staging.hatiprithwish.workers.dev",
        "SENTRY_PROJECT": "diletta",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "production": {
      "name": "diletta-web",
      "vars": {
        "VITE_API_URL": "https://diletta-worker.hatiprithwish.workers.dev",
        "SENTRY_PROJECT": "diletta",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
