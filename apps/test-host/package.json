{
  "name": "test-host",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --env staging",
    "generate-types": "wrangler types",
    "keygen": "tsx scripts/keygen.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.15.6",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
