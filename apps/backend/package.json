{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate --name diletta",
    "db:generate:sql": "drizzle-kit generate --custom --name",
    "db:migrate": "drizzle-kit migrate",
    "db:rollback": "node src/db/rollback.ts",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@clerk/backend": "^1.34.0",
    "@hono/zod-validator": "^0.8.0",
    "@logtape/hono": "^2.3.2",
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.5",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
