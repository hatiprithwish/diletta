{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate --name scaffold",
    "db:migrate": "wrangler d1 migrations apply scaffold-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@clerk/backend": "^1.34.0",
    "@hono/zod-validator": "^0.8.0",
    "@logtape/hono": "^2.3.2",
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "nanoid": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@types/node": "^25.9.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
