# ============================================================
# Local database config. Copy to apps/backend/.env (gitignored).
#
# All three point at the Neon STAGING branch, ?sslmode=verify-full.
# Local dev and tests share the staging DB. Never point local at production.
#
# DATABASE_URL → drizzle-kit (db:generate, db:migrate, db:rollback) and vitest
#   fixtures/cleanup. OWNER role (diletta_owner, BYPASSRLS), DIRECT host
#   (no "-pooler").
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE → wrangler dev + vitest
#   (replaces the HYPERDRIVE binding locally). APP role (diletta_app, subject to
#   RLS), DIRECT host. Same role the staging Hyperdrive config uses.
# NEON_POOLER_URL → vitest only. APP role (diletta_app), WITH the "-pooler" host
#   (PgBouncer, transaction mode). Local mode skips Hyperdrive's pool, so the
#   withTenant leak test runs through this pooler instead.
#   Required: the test fails without it.
#
# diletta_app's staging password: password manager entry
# "diletta_app (staging)". See docs/runbooks/app-role.md.
# ============================================================

DATABASE_URL=
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
NEON_POOLER_URL=
