{
  "name": "diletta-worker",
  "main": "src/index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_CORS_ORIGIN": "http://localhost:3000",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // DEV_NOTE: Local dev + tests use the staging branch. wrangler/vitest connect directly via
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from apps/backend/.env.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fd1f535077964b0782517cca25e7c988", // diletta-staging
    },
  ],
  "env": {
    "staging": {
      "name": "diletta-worker-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "fd1f535077964b0782517cca25e7c988", // diletta-staging
        },
      ],
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://diletta-web-staging.hatiprithwish.workers.dev",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "production": {
      "name": "diletta-worker",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "eae07e9a1dfb486a83ef1f5fe7ee7b51", // diletta-production
        },
      ],
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://diletta-web.hatiprithwish.workers.dev",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
