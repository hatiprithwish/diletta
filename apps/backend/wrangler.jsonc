{
  // DEV_NOTE: The top level is local dev and tests only; CI deploys with --env staging / --env production. Its name
  // and queues are deliberately not deployable targets: a stray `wrangler deploy` without --env can't overwrite the
  // production worker or take over a remote queue's consumer (the -local queues don't exist remotely, so it fails).
  "name": "diletta-worker-local",
  "main": "src/index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-06-11",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // DEV_NOTE: AI Gateway for the model router (M2-3, docs/runbooks/ai-gateway.md). Local dev uses the staging gateway;
  // AI_GATEWAY_TOKEN comes from .dev.vars locally and from a Secrets Store binding in each env.
  "vars": {
    "ALLOWED_CORS_ORIGIN": "http://localhost:3000",
    "AI_GATEWAY_ACCOUNT_ID": "6faf96669e14e06076115359a41497a0",
    "AI_GATEWAY_NAME": "diletta-staging",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // DEV_NOTE: Conversation DO (M2-2), one per conversation, built on Think (SQLite-backed). Reached only through the
  // widget route (GET /widget/ws), never routed publicly. BudgetDO (M2-4), one per company (SQLite kv): reserve before
  // and settle after every model call; reached only from the worker and the Conversation DO. Bindings don't inherit,
  // so each env declares its own; migrations do (top level only).
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION_DO", "class_name": "ConversationDO" },
      { "name": "BUDGET_DO", "class_name": "BudgetDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConversationDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BudgetDO"] },
  ],
  // DEV_NOTE: Local dev + tests use the staging branch. wrangler/vitest connect directly via
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from apps/backend/.env.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fd1f535077964b0782517cca25e7c988", // diletta-staging
    },
  ],
  // DEV_NOTE: Issuer JWKS cache for widget auth (M2-1). Local dev and tests run miniflare's simulated KV; the id is
  // the staging namespace's but is never reached locally.
  "kv_namespaces": [{ "binding": "JWKS_CACHE", "id": "749e76846f42489bb8445fbd3728c160" }], // diletta-jwks-staging
  // DEV_NOTE: Outbox relay target (M1-6). Local dev and tests run miniflare's simulated queue; local-only names.
  "queues": {
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "diletta-events-local" }],
    "consumers": [
      {
        "queue": "diletta-events-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "diletta-events-local-dlq",
      },
    ],
  },
  // DEV_NOTE: Every minute: outbox sweep (pending rows the after-commit relay missed) + purge of published rows, and
  // the model_calls usage backfill from AI Gateway logs (M2-3).
  // Daily 03:00 UTC: activity_log partition maintenance (M1-9). scheduled() matches these strings against
  // Constants.OUTBOX_SWEEP_CRON / ACTIVITY_LOG_PARTITIONS_CRON; change both together. triggers is inherited by every env.
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"],
  },
  "env": {
    "staging": {
      "name": "diletta-worker-staging",
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATION_DO", "class_name": "ConversationDO" },
          { "name": "BUDGET_DO", "class_name": "BudgetDO" },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "fd1f535077964b0782517cca25e7c988", // diletta-staging
        },
      ],
      // DEV_NOTE: Issuer JWKS cache for widget auth (M2-1). Bindings don't inherit, so each env declares its own.
      "kv_namespaces": [{ "binding": "JWKS_CACHE", "id": "749e76846f42489bb8445fbd3728c160" }], // diletta-jwks-staging
      // DEV_NOTE: Envelope-encryption master key (docs/runbooks/master-key.md). Bindings don't inherit,
      // so each env declares its own. Local reads MASTER_KEY_V1 from .dev.vars instead.
      "secrets_store_secrets": [
        {
          "binding": "MASTER_KEY_V1",
          "store_id": "bc38c3de34874ebaa3d415f7b42509d6", // default_secrets_store
          "secret_name": "diletta-master-key-v1-staging",
        },
        // DEV_NOTE: AI Gateway token (cf-aig-authorization) for the model router (M2-3, docs/runbooks/ai-gateway.md)
        {
          "binding": "AI_GATEWAY_TOKEN",
          "store_id": "bc38c3de34874ebaa3d415f7b42509d6", // default_secrets_store
          "secret_name": "diletta-aig-token-staging",
        },
      ],
      // DEV_NOTE: Outbox relay target (M1-6). The worker produces and consumes its own events; messages past
      // max_retries land in the DLQ. Bindings don't inherit, so each env declares its own.
      "queues": {
        "producers": [{ "binding": "EVENTS_QUEUE", "queue": "diletta-events-staging" }],
        "consumers": [
          {
            "queue": "diletta-events-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "diletta-events-staging-dlq",
          },
        ],
      },
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://diletta-web-staging.hatiprithwish.workers.dev",
        "AI_GATEWAY_ACCOUNT_ID": "6faf96669e14e06076115359a41497a0",
        "AI_GATEWAY_NAME": "diletta-staging",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "production": {
      "name": "diletta-worker",
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATION_DO", "class_name": "ConversationDO" },
          { "name": "BUDGET_DO", "class_name": "BudgetDO" },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "eae07e9a1dfb486a83ef1f5fe7ee7b51", // diletta-production
        },
      ],
      // DEV_NOTE: Issuer JWKS cache for widget auth (M2-1). Bindings don't inherit, so each env declares its own.
      "kv_namespaces": [{ "binding": "JWKS_CACHE", "id": "d510278f9d2c46a4aa5e87c42ab10509" }], // diletta-jwks-production
      // DEV_NOTE: Envelope-encryption master key (docs/runbooks/master-key.md). Bindings don't inherit,
      // so each env declares its own. Local reads MASTER_KEY_V1 from .dev.vars instead.
      "secrets_store_secrets": [
        {
          "binding": "MASTER_KEY_V1",
          "store_id": "bc38c3de34874ebaa3d415f7b42509d6", // default_secrets_store
          "secret_name": "diletta-master-key-v1-production",
        },
        // DEV_NOTE: AI Gateway token (cf-aig-authorization) for the model router (M2-3, docs/runbooks/ai-gateway.md)
        {
          "binding": "AI_GATEWAY_TOKEN",
          "store_id": "bc38c3de34874ebaa3d415f7b42509d6", // default_secrets_store
          "secret_name": "diletta-aig-token-production",
        },
      ],
      // DEV_NOTE: Outbox relay target (M1-6). The worker produces and consumes its own events; messages past
      // max_retries land in the DLQ. Bindings don't inherit, so each env declares its own.
      "queues": {
        "producers": [{ "binding": "EVENTS_QUEUE", "queue": "diletta-events-production" }],
        "consumers": [
          {
            "queue": "diletta-events-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "diletta-events-production-dlq",
          },
        ],
      },
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://diletta-web.hatiprithwish.workers.dev",
        "AI_GATEWAY_ACCOUNT_ID": "6faf96669e14e06076115359a41497a0",
        "AI_GATEWAY_NAME": "diletta-production",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
